# Business Central API configuration
# Copy this file to .env and fill in real values.
# IMPORTANT: Do not commit .env to source control.
# IMPORTANT: Use a newly rotated client secret if an old secret was ever shared.

BC_TENANT_ID=your-tenant-id
BC_ENVIRONMENT_NAME=Production
BC_CLIENT_ID=your-client-id
BC_CLIENT_SECRET=your-client-secret
BC_BASE_URL=https://api.businesscentral.dynamics.com/v2.0

# UKL custom API settings
BC_API_PUBLISHER=contoso
BC_API_GROUP=financeautomation
BC_API_VERSION=v1.0
BC_API_ENTITY_SET=planfulPushRuns
