# Business Central connection (same app registration as the Cost Centre automation)
BC_TENANT_ID=00000000-0000-0000-0000-000000000000
BC_ENVIRONMENT_NAME=Production
BC_CLIENT_ID=your-app-registration-client-id
BC_CLIENT_SECRET=your-client-secret
BC_SCOPE=https://api.businesscentral.dynamics.com/.default
BC_BASE_URL=https://api.businesscentral.dynamics.com/v2.0

# Master switch for production (any environment with "prod" in its name). false keeps it read-only.
# true still requires each app session to type the environment name in the sidebar to unlock changes.
ALLOW_PRODUCTION_UPDATES=true

# Set to false only if a corporate proxy breaks certificate checks.
BC_VERIFY_SSL=true

# Custom API route published by the AL extension
BC_API_PUBLISHER=contoso
BC_API_GROUP=financeautomation
BC_API_VERSION=v1.0
