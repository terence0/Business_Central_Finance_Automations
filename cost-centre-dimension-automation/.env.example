# Business Central connection
BC_TENANT_ID=00000000-0000-0000-0000-000000000000
BC_ENVIRONMENT_NAME=Sandbox_Test
BC_CLIENT_ID=your-app-registration-client-id
BC_CLIENT_SECRET=your-rotated-client-secret
